// The docs/design/pvm.md benchmark: sieve, gcd, sum and main. bench.s is its bytecode.
byte flags[200]
word a[10]
def sieve()
  word i, j, n
  n = 0
  for i = 2 to 199
    flags[i] = 1
  next
  for i = 2 to 199
    if flags[i]
      n = n + 1
      j = i + i
      while j < 200
        flags[j] = 0
        j = j + i
      loop
    fin
  next
  return n
end
def gcd(x, y)
  while x <> y
    if x > y
      x = x - y
    else
      y = y - x
    fin
  loop
  return x
end
def sum()
  word i, s
  for i = 0 to 9
    a[i] = i * 3
  next
  s = 0
  for i = 0 to 9
    s = s + a[i]
  next
  return s
end
def main()
  word t, k
  t = sieve()
  for k = 1 to 20
    t = t + gcd(k * 6, 84)
  next
  return t + sum()
end
main()
done
