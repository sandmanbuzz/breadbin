# Breadbin CI image: cc65 + VICE (x64sc) + xvfb + xdotool + python3, arm64 Debian.
# No ROMs are baked in; tools/ci/run.sh mounts them at /roms and entrypoint.sh
# copies them into VICE's data directory at container start.
#   podman build -t breadbin-ci -f tools/ci/Containerfile tools/ci
# The packages that decide what gets built and how it is run (the assembler and linker, the
# emulator, key injection, the interpreter, make) are pinned: a rebuild that cannot find a
# version fails loudly instead of drifting. The base image tag floats inside trixie-slim;
# pin it by digest (podman manifest inspect) when a build must be reproducible to the byte.
# A toolchain change is a deliberate edit here, checked with `make size` and the d64 hash
# against the previous image.
FROM mirror.gcr.io/library/debian:trixie-slim
# VICE lives in "contrib" on Debian.
RUN sed -i 's/^Components: main$/Components: main contrib/' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        cc65=2.19-2 vice=3.9+dfsg-1 xdotool=1:3.20160805.1-5.1 python3=3.13.5-1 python3-venv=3.13.5-1 make=4.4.1-2 \
        xvfb xauth util-linux lsof=4.99.4+dfsg-2 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# py65 (a 6502 emulator, the UCI simulator tests) is not packaged in Debian: a venv, pinned, so
# the 35 tests that skip without it run in the gate (docs/testing.md).
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir py65==1.2.0
ENV PATH=/opt/venv/bin:$PATH
COPY entrypoint.sh /usr/local/bin/breadbin-ci-entrypoint
RUN chmod +x /usr/local/bin/breadbin-ci-entrypoint
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/breadbin-ci-entrypoint"]
