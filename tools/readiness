#!/bin/sh
# Read-only report: is this clone, and the machine around it, in a state where it can be
# stopped, copied or handed over? Changes nothing.
#   tools/readiness            exit 0 = READY, 1 = NOT READY (blockers listed)
# Blockers: tracked changes or a half-done merge/rebase/cherry-pick in any worktree, a
# detached worktree whose commits sit on no branch, tag or remote branch (lost when the
# worktree is pruned), a git fsck connectivity error, a held machine lock, a running VICE
# or container. Info only: untracked files, stashes, reflog-only commits, ahead-of-origin,
# and the out-of-repo places that hold state (memory, transcripts, scratchpads, ROM cache).
# The RECORD block at the end (tips and a digest of every ref) is what to compare after a
# copy: the same digest on the other side means the same refs.
set -u
bad=0
blocker() { echo "  BLOCKER: $*"; bad=$((bad + 1)); }
info() { echo "  info: $*"; }

top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "readiness: not in a git clone" >&2; exit 2; }
common=$(cd "$top" && cd "$(git rev-parse --git-common-dir)" && pwd)
echo "== worktrees"
check_wt() {
    [ -n "$wt" ] || return 0
    if [ ! -d "$wt" ]; then
        # a stale registration (for example a path from another machine): harmless unless its
        # HEAD is on no ref, in which case pruning it would orphan those commits
        where=$(git for-each-ref --contains "$head" --count=1 --format='%(refname:short)' refs/heads refs/tags refs/remotes)
        if [ -n "$where" ]; then
            info "worktree $wt: directory missing, HEAD on $where (git worktree prune loses no commit)"
        else
            blocker "worktree $wt: directory missing and HEAD $(echo "$head" | cut -c1-7) is on no branch, tag or remote branch (prune would orphan it)"
        fi
        return 0
    fi
    n=$(git -C "$wt" status --porcelain 2>/dev/null | grep -vc '^??')
    u=$(git -C "$wt" status --porcelain 2>/dev/null | grep -c '^??')
    [ "$n" -gt 0 ] && blocker "$wt: $n tracked change(s) not committed"
    [ "$u" -gt 0 ] && info "$wt: $u untracked file(s)"
    gd=$(cd "$wt" && cd "$(git rev-parse --git-dir)" && pwd)
    for s in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply BISECT_LOG index.lock; do
        [ -e "$gd/$s" ] && blocker "$wt: $s present (an operation was interrupted)"
    done
    if [ "$det" = 1 ]; then
        where=$(git for-each-ref --contains "$head" --count=1 --format='%(refname:short)' refs/heads refs/tags refs/remotes)
        if [ -z "$where" ]; then
            blocker "$wt: detached at $(echo "$head" | cut -c1-7), on no branch, tag or remote branch"
        else
            info "$wt: detached at $(echo "$head" | cut -c1-7), also on $where"
        fi
    fi
    [ -n "$lockd" ] && info "$wt: locked worktree"
}
tmp=$(mktemp)
git worktree list --porcelain > "$tmp"
wt=; head=; det=0; lockd=
while IFS= read -r line; do
    case "$line" in
        "worktree "*) check_wt; wt=${line#worktree }; head=; det=0; lockd= ;;
        "HEAD "*) head=${line#HEAD } ;;
        detached) det=1 ;;
        locked*) lockd=1 ;;
    esac
done < "$tmp"
check_wt
nw=$(grep -c '^worktree ' "$tmp"); rm -f "$tmp"
info "$nw worktree(s)"

echo "== repository"
ns=$(git stash list | wc -l | tr -d ' ')
[ "$ns" -gt 0 ] && info "$ns stash entr$([ "$ns" -eq 1 ] && echo y || echo ies) (they live in .git: a whole-directory copy keeps them)"
if git rev-parse --verify -q origin/main >/dev/null && git rev-parse --verify -q main >/dev/null; then
    info "main is $(git rev-list --count origin/main..main) ahead of and $(git rev-list --count main..origin/main) behind origin/main"
fi
if ! git fsck --connectivity-only --no-dangling >/dev/null 2>&1; then
    blocker "git fsck --connectivity-only reports errors"
fi

ro=$(git log --reflog --not --branches --tags --remotes --glob=refs/stash --oneline 2>/dev/null)
if [ -n "$ro" ]; then
    info "$(echo "$ro" | wc -l | tr -d ' ') commit(s) reachable only from a reflog (first: $(echo "$ro" | head -1 | cut -c1-60)); a whole-directory copy keeps them, a clone does not"
fi

echo "== out of repo (candidates to pack; sizes in KB)"
primary=$(dirname "$common")
key=$(printf %s "$primary" | sed 's/[^A-Za-z0-9-]/-/g')
uid=$(id -u)
empty=0
for d in "$HOME/.claude/projects/$key" "$HOME/.claude/projects/$key/memory" \
         /tmp/claude-$uid/"$key"/*/scratchpad /tmp/claude-$uid/"$key"--claude-worktrees-*/*/scratchpad \
         "$HOME"/.claude/projects/"$key"--claude-worktrees-* \
         "${BREADBIN_CI_ROMS:-$HOME/.cache/breadbin-ci/roms}" "${BREADBIN_LOCKDIR:-/tmp/breadbin-locks}"; do
    [ -d "$d" ] || continue
    kb=$(du -sk "$d" 2>/dev/null | cut -f1)
    if [ "${kb:-0}" -eq 0 ]; then empty=$((empty + 1)); else info "$kb KB  $d"; fi
done
[ "$empty" -gt 0 ] && info "$empty more place(s) above are empty"
vl=$(ls "${TMPDIR:-/tmp}"/vice*.log 2>/dev/null | wc -l | tr -d ' ')
[ "$vl" -gt 0 ] && info "$vl VICE log file(s) in ${TMPDIR:-/tmp} (vicetest keeps them)"

echo "== machine"
dir=${BREADBIN_LOCKDIR:-/tmp/breadbin-locks}
if [ -d "$dir" ] && command -v flock >/dev/null 2>&1; then
    for lf in "$dir"/*.lock; do
        [ -e "$lf" ] || continue
        if ! flock -n "$lf" true 2>/dev/null; then
            hf=${lf%.lock}.holder
            blocker "lock $(basename "$lf") is held: $(cat "$hf" 2>/dev/null || echo unknown)"
        fi
    done
elif [ -d "$dir" ]; then
    info "flock not found: lock state not checked"
fi
if pgrep -f x64sc >/dev/null 2>&1; then
    blocker "VICE is running ($(pgrep -f x64sc | wc -l | tr -d ' ') process(es))"
fi
if command -v podman >/dev/null 2>&1; then
    c=$(podman ps --format '{{.Names}}' 2>/dev/null | tr '\n' ' ')
    [ -n "$c" ] && blocker "containers running: $c"
fi

echo "== RECORD (compare after a copy)"
sum() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
echo "  main    $(git rev-parse --verify -q main || echo none)"
echo "  HEAD    $(git rev-parse HEAD)"
echo "  refs    $(git for-each-ref | wc -l | tr -d ' ') ($(git for-each-ref --format='%(refname) %(objectname)' | sum | cut -c1-16) digest)"
echo "  common  $(basename "$common") ($(git count-objects -v | awk '/^count|^in-pack/{s+=$2} END{print s}') objects)"

if [ "$bad" -eq 0 ]; then
    echo "READY"
    exit 0
fi
echo "NOT READY: $bad blocker(s)"
exit 1
