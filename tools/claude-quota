#!/usr/bin/env python3
"""claude-quota — point-in-time and historical Claude subscription quota.

Uses the unofficial OAuth usage endpoint that Claude Code's /usage calls.
Stdlib only. Output is JSON by default so agents can parse it.

Commands
  now      [--record] [--human]      Fetch current utilization (+ burn projection from history)
  poll     [--quiet]                 Fetch and record; only writes a new row when values change
  history  [--since 24h] [--bucket five_hour] [--format json|csv]
  mark     "text" [--tag swarm]      Record a workload event to correlate against usage
  raw                                Print the raw upstream payload (debug schema drift)

Env
  CLAUDE_QUOTA_DB        SQLite path (default ~/.local/share/claude-quota/quota.db; holds raw
                         payloads: keep private, never commit; created 0600, dir 0700)
  CLAUDE_QUOTA_TOKEN     OAuth access token (overrides credential lookup)
  CLAUDE_CREDENTIALS     Path to Claude Code credentials JSON (default ~/.claude/.credentials.json)
  CLAUDE_QUOTA_BASE_URL  Override API base (default https://api.anthropic.com)

Exit codes: 0 ok, 2 auth problem (token missing/expired), 3 upstream/network error, 4 parse error.
"""
import argparse
import datetime as dt
import json
import os
import platform
import sqlite3
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE_URL = os.environ.get("CLAUDE_QUOTA_BASE_URL", "https://api.anthropic.com")
USAGE_PATH = "/api/oauth/usage"
BETA_HEADER = "oauth-2025-04-20"
DB_PATH = os.path.expanduser(
    os.environ.get("CLAUDE_QUOTA_DB", "~/.local/share/claude-quota/quota.db"))
CRED_PATH = os.path.expanduser(
    os.environ.get("CLAUDE_CREDENTIALS", "~/.claude/.credentials.json"))


class QuotaError(Exception):
    def __init__(self, msg, code):
        super().__init__(msg)
        self.code = code


# ---------------------------------------------------------------- time utils

def utcnow():
    return dt.datetime.now(dt.timezone.utc)


def iso(t):
    return t.astimezone(dt.timezone.utc).isoformat(timespec="seconds")


def parse_ts(v):
    """Accept ISO strings or unix seconds; return aware datetime or None."""
    if v is None or v == "":
        return None
    if isinstance(v, (int, float)):
        return dt.datetime.fromtimestamp(v, dt.timezone.utc)
    s = str(v).replace("Z", "+00:00")
    try:
        t = dt.datetime.fromisoformat(s)
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)


def parse_since(s):
    """'24h', '7d', '90m' or an ISO timestamp."""
    if s is None:
        return None
    units = {"m": 60, "h": 3600, "d": 86400}
    if s[-1:] in units and s[:-1].replace(".", "", 1).isdigit():
        return utcnow() - dt.timedelta(seconds=float(s[:-1]) * units[s[-1]])
    t = parse_ts(s)
    if not t:
        raise QuotaError(f"can't parse --since {s!r}", 4)
    return t


# ---------------------------------------------------------------- auth

def get_token():
    tok = os.environ.get("CLAUDE_QUOTA_TOKEN")
    if tok:
        return tok.strip()
    blob = None
    if os.path.exists(CRED_PATH):
        with open(CRED_PATH) as f:
            blob = f.read()
    elif platform.system() == "Darwin":
        try:
            blob = subprocess.run(
                ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                capture_output=True, text=True, check=True, timeout=10).stdout
        except (subprocess.SubprocessError, FileNotFoundError):
            blob = None
    if not blob:
        raise QuotaError("no OAuth token: log in with Claude Code, or set CLAUDE_QUOTA_TOKEN", 2)
    try:
        oauth = json.loads(blob).get("claudeAiOauth", {})
    except json.JSONDecodeError:
        raise QuotaError("credentials blob is not JSON", 2)
    tok = oauth.get("accessToken")
    if not tok:
        raise QuotaError("credentials found but no claudeAiOauth.accessToken", 2)
    exp = oauth.get("expiresAt")  # ms epoch
    if exp and exp / 1000 < utcnow().timestamp():
        raise QuotaError("OAuth token expired; run any Claude Code command to refresh it", 2)
    return tok


# ---------------------------------------------------------------- fetch + normalize

def fetch_raw():
    req = urllib.request.Request(BASE_URL + USAGE_PATH, headers={
        "Authorization": f"Bearer {get_token()}",
        "anthropic-beta": BETA_HEADER,
        "Content-Type": "application/json",
        "User-Agent": "claude-quota/1.0",
    })
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            body = r.read().decode()
    except urllib.error.HTTPError as e:
        code = 2 if e.code in (401, 403) else 3
        raise QuotaError(f"HTTP {e.code} from usage endpoint", code)
    except (urllib.error.URLError, TimeoutError) as e:
        raise QuotaError(f"network error: {e}", 3)
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        raise QuotaError("usage endpoint returned non-JSON", 4)


def _num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def normalize(raw):
    """Collapse whatever shape upstream sends into {bucket: {utilization, resets_at}}.

    Handles the flat keys (five_hour, seven_day, seven_day_<model>) and a
    generic `limits` array, since the schema has been drifting between the two.
    """
    buckets = {}

    def add(name, obj):
        if not isinstance(obj, dict):
            return
        u = _num(obj.get("utilization", obj.get("used_percentage", obj.get("percent_used"))))
        if u is None:
            return
        r = parse_ts(obj.get("resets_at", obj.get("reset_at", obj.get("resets"))))
        buckets[name] = {"utilization": u, "resets_at": iso(r) if r else None}

    for k, v in raw.items():
        if k in ("limits", "extra_usage"):
            continue
        add(k, v)

    for item in raw.get("limits") or []:
        if not isinstance(item, dict):
            continue
        name = item.get("name") or item.get("type") or item.get("id")
        scope = item.get("scope") or {}
        model = (scope.get("model") or {}).get("display_name") if isinstance(scope, dict) else None
        window = item.get("window") or item.get("period")
        if not name:
            name = "_".join(str(p) for p in (window, model) if p) or "limit"
        elif model and model.lower() not in str(name).lower():
            name = f"{name}_{model}"
        add(str(name).lower().replace(" ", "_"), item)

    extra = raw.get("extra_usage")
    if isinstance(extra, dict) and extra.get("is_enabled"):
        buckets["extra_usage"] = {
            "utilization": _num(extra.get("utilization")),
            "resets_at": None,
            "used_credits": _num(extra.get("used_credits")),
            "monthly_limit": _num(extra.get("monthly_limit")),
        }
    return buckets


def fingerprint(buckets):
    return json.dumps(buckets, sort_keys=True)


# ---------------------------------------------------------------- storage

SCHEMA = """
CREATE TABLE IF NOT EXISTS snapshots (
  id INTEGER PRIMARY KEY,
  first_seen TEXT NOT NULL,     -- when these values were first observed
  last_seen  TEXT NOT NULL,     -- last poll that still saw them (unchanged)
  fingerprint TEXT NOT NULL,
  raw TEXT NOT NULL             -- full upstream payload, for re-parsing after schema drift
);
CREATE TABLE IF NOT EXISTS buckets (
  snapshot_id INTEGER NOT NULL REFERENCES snapshots(id),
  bucket TEXT NOT NULL,
  utilization REAL,
  resets_at TEXT,
  PRIMARY KEY (snapshot_id, bucket)
);
CREATE TABLE IF NOT EXISTS marks (
  id INTEGER PRIMARY KEY,
  ts TEXT NOT NULL,
  tag TEXT,
  text TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS polls (
  ts TEXT PRIMARY KEY,
  ok INTEGER NOT NULL,
  changed INTEGER,
  error TEXT
);
CREATE INDEX IF NOT EXISTS idx_snap_first ON snapshots(first_seen);
CREATE INDEX IF NOT EXISTS idx_marks_ts ON marks(ts);
"""


def db(create=True):
    """Open the history DB. create=False: read-only, None if it does not exist."""
    if not create:
        if not os.path.exists(DB_PATH):
            return None
        con = sqlite3.connect("file:" + urllib.parse.quote(DB_PATH) + "?mode=ro",
                              uri=True, timeout=30)
        con.row_factory = sqlite3.Row
        return con
    d = os.path.dirname(DB_PATH)
    if d and not os.path.isdir(d):
        os.makedirs(d, mode=0o700, exist_ok=True)
    if not os.path.exists(DB_PATH):
        os.close(os.open(DB_PATH, os.O_CREAT | os.O_WRONLY, 0o600))
    con = sqlite3.connect(DB_PATH, timeout=30)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA journal_mode=WAL")  # concurrent agents reading while cron writes
    con.executescript(SCHEMA)
    return con


def record(con, raw, buckets, now):
    """Insert a snapshot only if values changed; otherwise extend last_seen."""
    fp = fingerprint(buckets)
    last = con.execute("SELECT id, fingerprint FROM snapshots ORDER BY id DESC LIMIT 1").fetchone()
    with con:
        if last and last["fingerprint"] == fp:
            con.execute("UPDATE snapshots SET last_seen=? WHERE id=?", (iso(now), last["id"]))
            changed = False
        else:
            cur = con.execute(
                "INSERT INTO snapshots(first_seen,last_seen,fingerprint,raw) VALUES (?,?,?,?)",
                (iso(now), iso(now), fp, json.dumps(raw)))
            con.executemany(
                "INSERT INTO buckets VALUES (?,?,?,?)",
                [(cur.lastrowid, b, v.get("utilization"), v.get("resets_at"))
                 for b, v in buckets.items()])
            changed = True
        con.execute("INSERT OR REPLACE INTO polls VALUES (?,?,?,NULL)", (iso(now), 1, int(changed)))
    return changed


def log_failure(con, now, err):
    with con:
        con.execute("INSERT OR REPLACE INTO polls VALUES (?,?,NULL,?)", (iso(now), 0, str(err)))


# ---------------------------------------------------------------- analysis

RESET_SLOP = 120  # seconds


def burn(con, bucket, current, now):
    """Linear fit of utilization over the current window (resets_at within 120 s).

    Returns rate in %/hour and projected utilization at reset. Uses both
    first_seen and last_seen of each snapshot so plateaus count as data.
    """
    resets_at = current.get("resets_at")
    if not resets_at or current.get("utilization") is None:
        return None
    reset_t = parse_ts(resets_at)
    rows = []
    if con is not None:
        # resets_at jitters by a few seconds between polls: match within RESET_SLOP
        for r in con.execute("""
                SELECT s.first_seen, s.last_seen, b.utilization, b.resets_at
                FROM buckets b JOIN snapshots s ON s.id=b.snapshot_id
                WHERE b.bucket=? AND b.resets_at IS NOT NULL ORDER BY s.first_seen""",
                (bucket,)):
            t = parse_ts(r["resets_at"])
            if t and abs((t - reset_t).total_seconds()) <= RESET_SLOP:
                rows.append(r)
    pts = []
    for r in rows:
        for t in {r["first_seen"], r["last_seen"]}:
            pts.append((parse_ts(t).timestamp(), r["utilization"]))
    pts.append((now.timestamp(), current["utilization"]))
    pts = sorted(set(pts))
    out = {"hours_to_reset": round((reset_t - now).total_seconds() / 3600, 2)}
    if len(pts) < 2 or pts[-1][0] - pts[0][0] < 300:
        out["note"] = "not enough history in this window for a rate"
        return out
    n = len(pts)
    mx = sum(p[0] for p in pts) / n
    my = sum(p[1] for p in pts) / n
    den = sum((p[0] - mx) ** 2 for p in pts)
    slope = sum((p[0] - mx) * (p[1] - my) for p in pts) / den if den else 0.0  # %/sec
    rate_h = slope * 3600
    remaining = max(0.0, 100.0 - current["utilization"])
    out["rate_pct_per_hour"] = round(rate_h, 3)
    out["projected_at_reset"] = round(
        current["utilization"] + rate_h * out["hours_to_reset"], 1)
    out["hours_until_cap"] = round(remaining / rate_h, 2) if rate_h > 0 else None
    out["will_cap_before_reset"] = bool(
        out["hours_until_cap"] is not None and out["hours_until_cap"] < out["hours_to_reset"])
    out["samples"] = n
    return out


# ---------------------------------------------------------------- commands

def cmd_now(a):
    now = utcnow()
    raw = fetch_raw()
    buckets = normalize(raw)
    if not buckets:
        raise QuotaError("payload had no recognizable buckets; run `claude-quota raw`", 4)
    con = db() if a.record else db(create=False)
    changed = record(con, raw, buckets, now) if a.record else None
    result = {"fetched_at": iso(now), "buckets": {}}
    for name, v in buckets.items():
        entry = dict(v)
        if v.get("utilization") is not None:
            entry["remaining"] = round(100 - v["utilization"], 1)
        b = burn(con, name, v, now)
        if b:
            entry["burn"] = b
        result["buckets"][name] = entry
    if a.record:
        result["recorded"] = changed
    if a.human:
        print_human(result)
    else:
        print(json.dumps(result, indent=2))


def print_human(result):
    print(f"as of {result['fetched_at']}")
    for name, v in result["buckets"].items():
        u = v.get("utilization")
        line = f"  {name:<22} {u if u is not None else '-':>6}%"
        if v.get("resets_at"):
            line += f"  resets {v['resets_at']}"
        b = v.get("burn") or {}
        if "rate_pct_per_hour" in b:
            line += f"  {b['rate_pct_per_hour']:+.2f}%/h → {b['projected_at_reset']}% at reset"
            if b.get("will_cap_before_reset"):
                line += f"  ⚠ caps in {b['hours_until_cap']}h"
        print(line)


def cmd_poll(a):
    now = utcnow()
    con = db()
    try:
        raw = fetch_raw()
        buckets = normalize(raw)
        if not buckets:
            raise QuotaError("payload had no recognizable buckets", 4)
    except QuotaError as e:
        log_failure(con, now, e)
        raise
    changed = record(con, raw, buckets, now)
    if not a.quiet:
        print(json.dumps({"ts": iso(now), "changed": changed}))


def cmd_history(a):
    con = db()
    since = parse_since(a.since)
    q = """SELECT s.first_seen, s.last_seen, b.bucket, b.utilization, b.resets_at
           FROM buckets b JOIN snapshots s ON s.id=b.snapshot_id WHERE 1=1"""
    args = []
    if since:
        q += " AND s.last_seen >= ?"
        args.append(iso(since))
    if a.bucket:
        q += " AND b.bucket = ?"
        args.append(a.bucket)
    q += " ORDER BY s.first_seen, b.bucket"
    rows = [dict(r) for r in con.execute(q, args)]
    mq = "SELECT ts, tag, text FROM marks" + (" WHERE ts >= ?" if since else "") + " ORDER BY ts"
    marks = [dict(r) for r in con.execute(mq, [iso(since)] if since else [])]
    if a.format == "csv":
        import csv
        w = csv.writer(sys.stdout)
        w.writerow(["kind", "first_seen", "last_seen", "bucket", "utilization", "resets_at", "tag", "text"])
        for r in rows:
            w.writerow(["usage", r["first_seen"], r["last_seen"], r["bucket"],
                        r["utilization"], r["resets_at"], "", ""])
        for m in marks:
            w.writerow(["mark", m["ts"], m["ts"], "", "", "", m["tag"] or "", m["text"]])
    else:
        print(json.dumps({"usage": rows, "marks": marks}, indent=2))


def cmd_mark(a):
    con = db()
    now = iso(utcnow())
    with con:
        con.execute("INSERT INTO marks(ts,tag,text) VALUES (?,?,?)", (now, a.tag, a.text))
    print(json.dumps({"ts": now, "tag": a.tag, "text": a.text}))


def cmd_raw(a):
    print(json.dumps(fetch_raw(), indent=2))


def main():
    p = argparse.ArgumentParser(prog="claude-quota", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("now", help="current utilization + burn projection")
    s.add_argument("--record", action="store_true", help="also store it in the history DB")
    s.add_argument("--human", action="store_true", help="readable output instead of JSON")
    s.set_defaults(fn=cmd_now)
    s = sub.add_parser("poll", help="fetch and record if changed (for cron/launchd)")
    s.add_argument("--quiet", action="store_true")
    s.set_defaults(fn=cmd_poll)
    s = sub.add_parser("history", help="dump recorded usage and marks")
    s.add_argument("--since", help="e.g. 24h, 7d, 90m, or an ISO timestamp")
    s.add_argument("--bucket")
    s.add_argument("--format", choices=["json", "csv"], default="json")
    s.set_defaults(fn=cmd_history)
    s = sub.add_parser("mark", help="record a workload event")
    s.add_argument("text")
    s.add_argument("--tag")
    s.set_defaults(fn=cmd_mark)
    s = sub.add_parser("raw", help="print raw upstream payload")
    s.set_defaults(fn=cmd_raw)
    a = p.parse_args()
    try:
        a.fn(a)
    except QuotaError as e:
        print(json.dumps({"error": str(e), "exit_code": e.code}), file=sys.stderr)
        sys.exit(e.code)


if __name__ == "__main__":
    main()
