; Generated by gen_sweep.py (runner + records). Every stable undocumented opcode, every
; addressing mode, several inputs each, against a software model. Runs under SEI, no KERNAL.
; Result: $C000 = failures, $C001 = $5A when finished, $C002/3 = cases run, $C010.. = ids of
; the first 16 failures (16-bit), $C050.. = got A,X,Y,P&$C3,zp cell,abs cell for each.
.setcpu "6502X"
N = @NCASES@
rp = $f0
cnt = $f2
ta = $f4                ; ta tx ty tc tm in this order
tx = $f5
ty = $f6
tc = $f7
tm = $f8
tramp = $c200

.segment "LOADADDR"
        .word $0801
.segment "STUB"
        .word @next, 10
        .byte $9e, "2061", 0
@next:  .word 0

.segment "BSS"
nfail:  .res 1
magic:  .res 1
ran:    .res 2
        .res 12
fails:  .res 32
        .res 16
dumps:  .res 96
got:
ra:     .res 1
rx:     .res 1
ry:     .res 1
rpp:    .res 1
gz:     .res 1
ga:     .res 1
doff:   .res 1

.segment "CODE"
        sei
        cld
        ldx #$ff
        txs
@INIT@
        lda #0
        sta nfail
        sta magic
        sta doff
        lda #<recs
        sta rp
        lda #>recs
        sta rp+1
        lda #<N
        sta cnt
        lda #>N
        sta cnt+1
next:   ldy #0
        lda (rp),y
        sta ta                  ; len, borrowed
        ldy #1
@c:     lda (rp),y
        sta tramp-1,y
        iny
        dec ta
        bne @c
        lda #$4c
        sta tramp-1,y
        lda #<cap
        sta tramp,y
        lda #>cap
        sta tramp+1,y
        ldy #4
@t:     lda (rp),y
        sta ta-4,y
        iny
        cpy #9
        bne @t
        lda tm
        sta $fa
        sta $c100
        clv
        lda tc
        lsr
        ldx tx
        ldy ty
        lda ta
        jmp tramp
cap:    php
        sta ra
        stx rx
        sty ry
        pla
        and #$c3
        sta rpp
        lda $fa
        sta gz
        lda $c100
        sta ga
        ldx #0
        ldy #9
@k:     lda got,x
        cmp (rp),y
        bne fail
        inx
        iny
        cpx #6
        bne @k
        beq adv
fail:   lda nfail
        cmp #16
        bcs @n
        asl
        tax
        lda #<N
        sec
        sbc cnt
        sta fails,x
        lda #>N
        sbc cnt+1
        sta fails+1,x
        ldx doff
        ldy #0
@d:     lda got,y
        sta dumps,x
        inx
        iny
        cpy #6
        bne @d
        stx doff
@n:     inc nfail
        bne adv
        dec nfail
adv:    lda rp
        clc
        adc #15
        sta rp
        bcc @a
        inc rp+1
@a:     lda cnt
        bne @b
        dec cnt+1
@b:     dec cnt
        lda cnt
        ora cnt+1
        beq done
        jmp next
done:   lda #<N
        sta ran
        lda #>N
        sta ran+1
        lda #$5a
        sta magic
        ldx #9
@s:     lda nfail
        beq @p
        lda msgf,x
        jmp @w
@p:     lda msgp,x
@w:     sta $0400,x
        dex
        bpl @s
        jmp *
msgp:   .byte 19,23,5,5,16,32,16,1,19,19
msgf:   .byte 19,23,5,5,16,32,6,1,9,12
